# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment and secrets
.env
*.env
.env.secrets               # actual secrets — NEVER commit
cookies.json               # Uber session cookies — NEVER commit
storage_state.json         # Playwright storage state — NEVER commit
cookies_b64.txt            # base64-encoded session dump — never commit
*.b64                      # any other base64 credential files
org_uuids.json             # discovered org UUIDs cache

# Chrome user profiles
uber_chrome_profile/
real_chrome_user_data/
temp_chrome_profile/

# Temporary directories and artifacts
screenshots/
uber_reports/
downloads/

# IDE / System
.vscode/
.idea/
.DS_Store
Thumbs.db
